# ==========================================
# KissanSetuAI Backend Configuration (.env.example)
# SIH Problem Statement: SIH26132
# ==========================================

# Application Settings
PROJECT_NAME="KissanSetuAI Backend"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisansetu"

# Security & Authentication
SECRET_KEY="replace_this_with_a_super_secret_generated_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# LLM Configuration (Phase 2 & Phase 8)
# Supported providers: 'gemini', 'openai', 'groq', 'mock'
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3

# Cloudinary Storage Configuration (Phase 3)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_IMAGE_SIZE_MB=10

# Vision AI Configuration (Phase 3)
# Supported providers: 'gemini', 'mock'
VISION_PROVIDER="gemini"
VISION_MODEL="gemini-1.5-flash"

# Voice AI Configuration (Phase 7)
VOICE_ENABLED=True
# Speech-to-Text: 'whisper', 'google', 'mock'
STT_PROVIDER="mock"
STT_API_KEY=""
STT_MODEL="whisper-1"
# Text-to-Speech: 'gtts', 'openai', 'mock'
TTS_PROVIDER="mock"
TTS_API_KEY=""
TTS_MODEL="tts-1"
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SEC=60

# Verified Agricultural Knowledge + RAG Configuration (Phase 8)
RAG_ENABLED=True
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.55
# Embedding Provider: 'openai', 'mock'
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=128

# External Service Keys (Optional integrations)
OPENWEATHER_API_KEY=""
GOV_MANDI_API_KEY=""
