# ==========================================
# KissanSetuAI Backend Configuration
# ==========================================

# Application
PROJECT_NAME="KissanSetuAI Backend API"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisansetu"

# Security & Authentication
SECRET_KEY="replace_this_with_a_super_secret_generated_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# External APIs (Placeholders for future phases)
OPENWEATHER_API_KEY=""
GOV_MANDI_API_KEY=""
AI_SERVICE_URL=""
